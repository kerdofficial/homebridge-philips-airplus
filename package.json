{
  "name": "homebridge-philips-airplus",
  "version": "0.1.1",
  "description": "Homebridge integration for Philips Air+ HU1509 and HU1510 humidifiers",
  "type": "module",
  "author": "Dániel Kerekes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kerdofficial/homebridge-philips-airplus.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "homebridge-plugin"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-ui.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test test/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm build",
    "audit:package": "node scripts/audit-package.mjs"
  },
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "mqtt": "^5.16.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "homebridge": "^2.4.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
